APP_NAME="filebase"
TZ="Asia/Kolkata"

# Docker
DATA_DIR=".data"

# Logging configuration
LOG_LEVEL="debug"

# Server configuration
SERVER_HOST="filebase"
SERVER_PORT="3000"
SERVER_BASE_PATH="/api"
SERVER_TIMEOUT_SECONDS="30"

# Database configuration
DATABASE_URL="sqlite:.data/filebase.db"
DATABASE_MAX_CONNECTIONS="10"
DATABASE_TIMEOUT_SECONDS="15"
