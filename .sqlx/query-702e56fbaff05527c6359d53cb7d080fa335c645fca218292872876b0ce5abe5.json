  "query": "\n                UPDATE files\n                SET\n                    folder_id = COALESCE(?, folder_id),\n                    name = COALESCE(?, name),\n                    updated_at = datetime('now')\n                WHERE object_key IS ? AND is_uploaded = 1\n                RETURNING\n                    id AS \"id!\", folder_id, object_key, name,\n                    size, content_type, checksum, is_uploaded,\n                    created_at, updated_at\n            ",
