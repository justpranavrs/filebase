APP_NAME="filebase"
TZ="Asia/Kolkata"

# Docker
DATA_DIR="/var/lib/filebase/data"
DATABASE_BACKUP="/var/lib/filebase/backups"
REVERSE_PROXY_PORT="80"

# Logging configuration
LOG_LEVEL="debug"

# Server configuration
SERVER_HOST="filebase"
SERVER_PORT="3000"
SERVER_TIMEOUT_SECONDS="30"

# Database configuration
DATABASE_URL="sqlite:/var/lib/filebase/data/filebase.db"
DATABASE_MAX_CONNECTIONS="10"
DATABASE_TIMEOUT_SECONDS="15"

# Storage configuration
STORAGE_DIR="/var/lib/filebase/storage"
